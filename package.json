{
  "name": "vocareum-publisher",
  "version": "1.1.1",
  "description": "Publish assignment content from GitHub to Vocareum",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "vocgit": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "probe:api": "node scripts/probe-vocareum-api.mjs",
    "probe:v3": "node scripts/probe-v3-oauth.mjs",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write 'src/**/*.ts'",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist",
    "action.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "vocareum",
    "education",
    "assignments",
    "publishing",
    "cli",
    "github-action"
  ],
  "author": "Vocareum",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ddlin/vocareum-publisher.git"
  },
  "bugs": {
    "url": "https://github.com/ddlin/vocareum-publisher/issues"
  },
  "homepage": "https://github.com/ddlin/vocareum-publisher#readme",
  "dependencies": {
    "axios": "^1.6.0",
    "chalk": "^4.1.2",
    "commander": "^11.1.0",
    "cosmiconfig": "^9.0.0",
    "form-data": "^4.0.0",
    "inquirer": "^9.2.0",
    "js-yaml": "^4.1.0",
    "ora": "^7.0.0",
    "simple-git": "^3.21.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.7",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "@vitest/coverage-v8": "^3.2.6",
    "eslint": "^8.57.1",
    "prettier": "^3.1.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vitest": "^3.2.6"
  }
}
